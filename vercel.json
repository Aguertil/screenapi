{
  "buildCommand": "pnpm --filter screenapi build",
  "installCommand": "npm i -g pnpm@9 && pnpm install",
  "framework": "nextjs",
  "outputDirectory": "apps/screenapi/.next",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/screenapi/$1"
    }
  ],
  "env": {
    "PNPM_VERSION": "9.0.0"
  },
  "build": {
    "env": {
      "PNPM_VERSION": "9.0.0"
    }
  }
}
