FROM node:20-slim AS base

# Install system dependencies
RUN apt-get update -y && \
    apt-get install -y \
    openssl \
    ca-certificates \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@9.0.0

WORKDIR /app

# Copy workspace configuration
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./

# Copy all package.json files for dependency resolution
COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-config/package.json ./packages/shared-config/
COPY packages/shared-ui/package.json ./packages/shared-ui/
COPY packages/testing/package.json ./packages/testing/
COPY apps/screenapi/package.json ./apps/screenapi/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy all source code
COPY packages ./packages
COPY apps/screenapi ./apps/screenapi

# Generate Prisma Client
RUN cd packages/database && pnpm exec prisma generate

# Install Playwright with dependencies
RUN npx playwright@1.64.1 install chromium --with-deps

# Build the app
RUN cd apps/screenapi && pnpm run build

# Production stage
FROM node:20-slim

# Install production runtime dependencies
RUN apt-get update -y && \
    apt-get install -y \
    openssl \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9.0.0

# Copy workspace config
COPY --from=base /app/pnpm-workspace.yaml ./
COPY --from=base /app/package.json ./
COPY --from=base /app/pnpm-lock.yaml ./

# Copy package.json files
COPY --from=base /app/packages/database/package.json ./packages/database/
COPY --from=base /app/apps/screenapi/package.json ./apps/screenapi/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Copy built application and generated Prisma client
COPY --from=base /app/apps/screenapi/.next ./apps/screenapi/.next
COPY --from=base /app/apps/screenapi/public ./apps/screenapi/public
COPY --from=base /app/packages/database/prisma ./packages/database/prisma
COPY --from=base /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=base /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=base /app/packages/database ./packages/database

# Install playwright in production
RUN npx playwright@1.64.1 install chromium --with-deps

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME="0.0.0.0"

WORKDIR /app/apps/screenapi

CMD ["pnpm", "start", "-p", "8080"]
