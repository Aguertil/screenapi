{
  "version": 2,
  "builds": [
    {
      "src": "apps/screenapi/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/screenapi/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "apps/screenapi/src/app/api/v1/screenshot/route.ts": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
