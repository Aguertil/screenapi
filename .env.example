# Database
DATABASE_URL="postgresql://screenapi:screenapi_dev_password@localhost:5432/screenapi?schema=public"

# Redis (optional - falls back to in-memory if not set)
REDIS_URL="redis://localhost:6379"

# Node Environment
NODE_ENV="development"

# Port (optional, defaults to 43210)
PORT="43210"

