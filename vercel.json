{
  "version": 2,
  "buildCommand": "cd apps/screenapi && pnpm install && pnpm build",
  "outputDirectory": "apps/screenapi/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "functions": {
    "apps/screenapi/src/app/api/**/*.ts": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
