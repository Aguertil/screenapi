FROM node:20

# Install Playwright system dependencies
RUN apt-get update && apt-get install -y \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN corepack enable && corepack prepare pnpm@latest --activate

RUN pnpm install

RUN pnpm --filter @repo/database db:generate

# Install Playwright package temporarily and download Chromium browser
RUN npm install -g playwright && playwright install chromium --with-deps

EXPOSE 43210

CMD ["sh", "-c", "pnpm --filter @repo/database db:push && pnpm --filter screenapi dev --hostname 0.0.0.0"]
