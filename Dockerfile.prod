FROM node:20-slim AS base

# Install OpenSSL for Prisma
RUN apt-get update -y && \
    apt-get install -y openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@9.0.0

WORKDIR /app

# Copy package files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY apps/screenapi/package.json ./apps/screenapi/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages ./packages
COPY apps/screenapi ./apps/screenapi
COPY turbo.json ./

# Generate Prisma client
RUN cd packages/database && pnpm exec prisma generate

# Install Playwright and chromium
RUN pnpm add -g playwright@1.64.1 && \
    apt-get update -y && \
    playwright install chromium --with-deps && \
    rm -rf /var/lib/apt/lists/*

# Build the Next.js app
WORKDIR /app/apps/screenapi
RUN pnpm run build

# Production image
FROM node:20-slim

# Install runtime dependencies
RUN apt-get update -y && \
    apt-get install -y \
    openssl \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgbm1 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built application
COPY --from=base /app/apps/screenapi/.next/standalone ./
COPY --from=base /app/apps/screenapi/.next/static ./apps/screenapi/.next/static
COPY --from=base /app/apps/screenapi/public ./apps/screenapi/public

# Copy Prisma for migrations
COPY --from=base /app/packages/database/prisma ./packages/database/prisma
COPY --from=base /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=base /app/node_modules/@prisma ./node_modules/@prisma

# Install pnpm and playwright in production
RUN npm install -g pnpm@9.0.0 playwright@1.64.1 && \
    playwright install chromium --with-deps

# Create non-root user
RUN groupadd -r nodejs && useradd -r -g nodejs nodejs && \
    chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/screenapi/server.js"]
