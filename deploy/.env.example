# ---- À remplir sur le serveur (deploy/.env). Ne jamais committer ce fichier. ----
DOMAIN=screenapi.example.com
CONTACT_EMAIL=contact@example.com

# Générés automatiquement par install.sh
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=

# Comptes administrateurs (page /admin), séparés par des virgules
ADMIN_EMAILS=

# Captures simultanées (3 pour 4 Go de mémoire)
MAX_CONCURRENCY=3
CACHE_MAX_MB=200

# Stripe (Tableau de bord Stripe → Développeurs → Clés API). Laisser vide = paiements fermés.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# true seulement si Stripe Tax est activé sur le compte
STRIPE_AUTOMATIC_TAX=false

# E-mails (Resend, facultatif) : bienvenue, paiement, échec de paiement
RESEND_API_KEY=
FROM_EMAIL=

# Connexion Google / GitHub (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
